<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Shopping List &mdash; Detroit Bridal Shower</title>
<link rel="icon" href="/assets/images/bridalshowerpic.jpg">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root { --ivory:#faf7f2; --card:#fffdfa; --sage:#6b7066; --sage-deep:#494e46; --sage-darker:#383c36; --sage-soft:#eef0ec;
    --gold:#b3925a; --gold-soft:#f3ead9; --ink:#2e2e29; --ink-soft:#6d6d64; --line:#e7e2d8; --danger:#b05252; --danger-soft:#f6e4e4;
    --ok:#5f7d5f; --ok-soft:#e5eee5; --serif:'Cormorant Garamond',Georgia,serif; --sans:'Jost','Segoe UI',sans-serif;
    --shadow:0 1px 2px rgba(56,60,54,.05), 0 8px 24px -12px rgba(56,60,54,.18); }
  * { margin:0; padding:0; box-sizing:border-box; }
  body { font-family:var(--sans); background:var(--ivory); color:var(--ink); }
  button { font-family:var(--sans); cursor:pointer; }
  .sidebar { width:232px; background:linear-gradient(175deg,var(--sage-deep) 0%,var(--sage-darker) 100%); color:#efeee9;
    position:fixed; inset:0 auto 0 0; padding:28px 18px 22px; display:flex; flex-direction:column; }
  .brand { text-align:center; padding-bottom:24px; border-bottom:1px solid rgba(255,255,255,.12); }
  .medallion { width:92px; height:92px; border-radius:50%; background:#fff; margin:0 auto 12px; display:flex; align-items:center; justify-content:center;
    box-shadow:0 0 0 4px rgba(255,255,255,.12); overflow:hidden; }
  .medallion img { width:74%; height:74%; object-fit:contain; }
  .brand h1 { font-family:var(--serif); font-weight:600; font-size:21px; letter-spacing:.12em; text-transform:uppercase; line-height:1.35; }
  .brand span { display:block; font-weight:300; font-size:10.5px; letter-spacing:.38em; text-transform:uppercase; color:#cdbf9d; margin-top:6px; }
  .nav { margin-top:26px; display:flex; flex-direction:column; gap:4px; }
  .nav a { display:flex; align-items:center; gap:12px; color:#d8d7cf; text-decoration:none; font-size:14.5px; padding:11px 14px; border-radius:10px; letter-spacing:.04em; }
  .nav a svg { width:17px; height:17px; flex:none; opacity:.8; }
  .nav a:hover { background:rgba(255,255,255,.07); color:#fff; }
  .nav a.active { background:rgba(179,146,90,.18); color:#ecd9b4; }
  .nav a.active svg { opacity:1; }
  .main { margin-left:232px; padding:26px 36px 60px; }
  h2 { font-family:var(--serif); font-weight:600; font-size:34px; color:var(--sage-darker); margin-bottom:4px; }
  .subtitle { color:var(--ink-soft); font-weight:300; font-size:14px; margin-bottom:22px; }
  .grid { display:grid; grid-template-columns:1fr 340px; gap:22px; align-items:start; }
  .card { background:var(--card); border:1px solid var(--line); border-radius:18px; box-shadow:var(--shadow); margin-bottom:22px; overflow:hidden; }
  .card-head { padding:18px 22px 12px; display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; }
  .card-head h3 { font-family:var(--serif); font-size:22px; font-weight:600; color:var(--sage-darker); }
  .count { font-size:12px; color:var(--ink-soft); font-weight:300; }
  .body { padding:0 22px 20px; }
  .btn { display:inline-flex; align-items:center; gap:7px; border:none; border-radius:999px; padding:10px 18px; font-size:13.5px; font-weight:500; text-decoration:none; }
  .btn-gold { background:var(--gold); color:#fff; } .btn-gold:hover { background:#a3854f; }
  .btn-ghost { background:transparent; border:1px solid var(--line); color:var(--sage-deep); } .btn-ghost:hover { background:var(--sage-soft); }
  .chips { display:flex; gap:8px; flex-wrap:wrap; }
  .chip { border:1px solid var(--line); background:#fff; border-radius:999px; padding:7px 15px; font-size:12.5px; color:var(--sage-deep); }
  .chip.active { background:var(--sage-deep); border-color:var(--sage-deep); color:#fff; }
  .item { display:flex; align-items:center; gap:16px; padding:15px 22px; border-bottom:1px solid #f0ece3; }
  .item:last-child { border-bottom:none; }
  .item b { font-family:var(--serif); font-size:30px; color:var(--gold); line-height:1; min-width:52px; text-align:right; }
  .item .nm { flex:1; font-size:16px; color:var(--ink); }
  .item details { margin-top:3px; }
  .item summary { font-size:11.5px; color:var(--gold); cursor:pointer; list-style:none; width:fit-content; }
  .item summary::-webkit-details-marker { display:none; }
  .item summary:hover { text-decoration:underline; }
  .item .who { font-size:11.5px; color:var(--ink-soft); margin-top:5px; line-height:1.6; }
  .couple { padding:12px 22px; border-bottom:1px solid #f0ece3; display:flex; gap:14px; align-items:flex-start; }
  .couple:last-child { border-bottom:none; }
  .couple .nm { font-family:var(--serif); font-size:17px; color:var(--ink); flex:1; min-width:0; }
  .tags { display:flex; gap:6px; flex-wrap:wrap; justify-content:flex-end; max-width:60%; }
  .tag { background:var(--gold-soft); color:#8a6f3e; border-radius:999px; padding:3px 11px; font-size:11.5px; white-space:nowrap; }
  .tag.none { background:var(--sage-soft); color:var(--ink-soft); }
  .scroll { max-height:620px; overflow-y:auto; }
  .empty { padding:26px 22px; text-align:center; color:var(--ink-soft); font-weight:300; font-size:14px; }
  .stat { display:flex; align-items:center; gap:14px; padding:18px 22px; }
  .stat b { font-family:var(--serif); font-size:34px; color:var(--gold); line-height:1; }
  .stat span { font-size:12px; letter-spacing:.1em; text-transform:uppercase; color:var(--ink-soft); }
  .toasts { position:fixed; bottom:22px; right:22px; z-index:200; display:flex; flex-direction:column; gap:10px; }
  .toast { background:var(--sage-darker); color:#f4f3ee; border-radius:12px; padding:13px 18px; font-size:14px; max-width:340px; }
  .toast.err { background:var(--danger); }
  @media (max-width:1080px){ .grid{grid-template-columns:1fr;} }
  @media (max-width:860px){ .sidebar{display:none;} .main{margin-left:0; padding:20px 14px;} .tags{max-width:100%; justify-content:flex-start;} .couple{flex-direction:column; gap:6px;} }
</style>
</head>
<body>
<aside class="sidebar">
  <div class="brand">
    <div class="medallion"><img src="/assets/images/bridalshowerpic.jpg" alt=""></div>
    <h1>Detroit<br>Bridal Shower</h1><span>Admin</span>
  </div>
  <nav class="nav">
    <a href="/newAdmin">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
      Dashboard
    </a>
    <a href="/newAdmin/contributions">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M20 12v8H4v-8M2 7h20v5H2zM12 22V7M12 7s-2-4-5-4-3 4 0 4h5zM12 7s2-4 5-4 3 4 0 4h-5z"/></svg>
      Contributions
    </a>
    <a href="/newAdmin/shoppingList" class="active">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M6 6 5 2H2"/></svg>
      Shopping List
    </a>
    <a href="/newAdmin/mailingList">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
      Mailing List
    </a>
    <a href="/" target="_blank">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M3.5 12h17M12 3c2.5 2.6 3.8 5.7 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z"/></svg>
      View Website
    </a>
  </nav>
</aside>
<main class="main">
  <h2>Shopping List</h2>
  <div class="subtitle">Everything the couples asked for in their Detroit Chesed Package, totalled up. Taken straight from each couple&rsquo;s own submission &mdash; nothing to keep up to date here.</div>
  <div class="grid">
    <div>
      <div class="card">
        <div class="card-head">
          <h3>What to buy</h3>
          <div class="chips" id="scopeChips">
            <button class="chip active" data-scope="collecting" onclick="setScope('collecting')">Still collecting</button>
            <button class="chip" data-scope="all" onclick="setScope('all')">All couples</button>
          </div>
        </div>
        <div id="itemList"></div>
      </div>
      <div class="card">
        <div class="card-head"><h3>By couple</h3><span class="count" id="coupleCount"></span></div>
        <div class="scroll" id="coupleList"></div>
      </div>
    </div>
    <div>
      <div class="card">
        <div class="stat"><b id="statItems">0</b><span>items to buy<br>in total</span></div>
        <div class="stat" style="border-top:1px solid var(--line);"><b id="statCouples">0</b><span>couples<br>asked for something</span></div>
      </div>
      <div class="card">
        <div class="card-head"><h3>Take it with you</h3></div>
        <div class="body">
          <div style="font-size:12.5px; color:var(--ink-soft); font-weight:300; line-height:1.5; margin-bottom:14px;">
            Print it for the shop, or copy it as plain text to send to whoever is doing the buying.
          </div>
          <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <button class="btn btn-gold" onclick="printSheet()">&#128438; Print</button>
            <button class="btn btn-ghost" onclick="copySheet()">Copy as text</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
<div class="toasts" id="toasts"></div>
<script>
const $ = (id) => document.getElementById(id);
const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
function toast(m, err) { const t = document.createElement('div'); t.className = 'toast' + (err ? ' err' : ''); t.textContent = m; $('toasts').appendChild(t); setTimeout(() => t.remove(), 3500); }

// send an expired session to the login screen rather than failing silently
const _fetch = window.fetch;
window.fetch = async (url, opts) => {
  const res = await _fetch(url, opts);
  if (res.status === 401 && String(url).startsWith('/newAdmin')) {
    window.location.href = '/login?expired=1&next=' + encodeURIComponent(window.location.pathname);
  }
  return res;
};

// the order the options appear on the couple's own form, so the sheet reads
// the same way every time; anything unexpected is listed after these
const ORDER = ['Toaster', 'Urn', 'Kitchen towels', 'Vacuum', 'Cholent pot'];
let couples = [];
let scope = 'collecting';

function itemsOf(c) {
  return String(c.chesedPackage || '').split(',').map(s => s.trim()).filter(Boolean);
}
function inScope() {
  return couples.filter(c => c.verified && (scope === 'all' || c.collecting));
}
function tally() {
  const counts = new Map();
  inScope().forEach(c => itemsOf(c).forEach(i => {
    if (!counts.has(i)) counts.set(i, []);
    counts.get(i).push(c.chossonName + ' & ' + c.kallahName);
  }));
  return [...counts.entries()].sort((a, b) => {
    const ia = ORDER.indexOf(a[0]), ib = ORDER.indexOf(b[0]);
    if (ia !== ib) return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib);
    return a[0].localeCompare(b[0]);
  });
}

function setScope(s) {
  scope = s;
  document.querySelectorAll('#scopeChips .chip').forEach(ch => ch.classList.toggle('active', ch.dataset.scope === s));
  render();
}

function render() {
  const list = inScope();
  const counts = tally();
  const asked = list.filter(c => itemsOf(c).length);

  $('statItems').textContent = counts.reduce((s, [, who]) => s + who.length, 0);
  $('statCouples').textContent = asked.length;

  $('itemList').innerHTML = counts.length ? counts.map(([name, who]) => `
    <div class="item">
      <b>${who.length}</b>
      <div class="nm">${esc(name)}
        <details>
          <summary>who asked for it (${who.length})</summary>
          <div class="who">${who.map(esc).join(' &middot; ')}</div>
        </details>
      </div>
    </div>`).join('')
    : '<div class="empty">No couples in this view have asked for anything yet.</div>';

  const none = list.length - asked.length;
  $('coupleCount').textContent = list.length
    ? asked.length + ' of ' + list.length + (none ? ' — ' + none + ' asked for nothing' : '')
    : '';
  $('coupleList').innerHTML = list.length ? list
    .slice()
    .sort((a, b) => itemsOf(b).length - itemsOf(a).length ||
      (a.chossonName + a.kallahName).localeCompare(b.chossonName + b.kallahName))
    .map(c => {
      const items = itemsOf(c);
      return `<div class="couple">
        <div class="nm">${esc(c.chossonName)} &amp; ${esc(c.kallahName)}</div>
        <div class="tags">${items.length
          ? items.map(i => `<span class="tag">${esc(i)}</span>`).join('')
          : '<span class="tag none">nothing requested</span>'}</div>
      </div>`;
    }).join('')
    : '<div class="empty">No couples to show.</div>';
}

// ---- taking it out of the dashboard ----
function sheetText() {
  const when = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
  const lines = ['Detroit Bridal Shower — shopping list',
    (scope === 'all' ? 'All couples' : 'Couples still collecting') + ' · ' + when, ''];
  tally().forEach(([name, who]) => lines.push(who.length + ' x ' + name));
  lines.push('', 'By couple:');
  inScope().forEach(c => {
    const items = itemsOf(c);
    if (items.length) lines.push('  ' + c.chossonName + ' & ' + c.kallahName + ': ' + items.join(', '));
  });
  return lines.join('\n');
}
async function copySheet() {
  try {
    await navigator.clipboard.writeText(sheetText());
    toast('Shopping list copied — paste it into a text or email.');
  } catch (e) {
    toast('Could not copy automatically — use Print instead.', true);
  }
}
function printSheet() {
  const counts = tally();
  if (!counts.length) { toast('Nothing to print for this selection.', true); return; }
  const when = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
  const w = window.open('', '_blank');
  if (!w) { toast('Your browser blocked the print window — allow popups for this site.', true); return; }
  const rows = counts.map(([name, who]) => `
    <tr><td class="box"></td><td class="qty">${who.length}</td><td>${esc(name)}</td></tr>`).join('');
  const byCouple = inScope().filter(c => itemsOf(c).length).map(c => `
    <tr><td>${esc(c.chossonName)} &amp; ${esc(c.kallahName)}</td><td>${itemsOf(c).map(esc).join(', ')}</td></tr>`).join('');
  w.document.write(`<!DOCTYPE html><html><head><title>Shopping List — Detroit Bridal Shower</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    body { font-family:'Jost','Segoe UI',sans-serif; color:#2e2e29; margin:40px; }
    h1 { font-family:'Cormorant Garamond',Georgia,serif; font-weight:600; color:#383c36; margin:0 0 2px; }
    h2 { font-family:'Cormorant Garamond',Georgia,serif; font-weight:600; color:#383c36; font-size:20px; margin:30px 0 8px; }
    .sub { color:#6d6d64; font-size:13px; margin-bottom:20px; }
    table { width:100%; border-collapse:collapse; }
    td, th { padding:9px 10px; border-bottom:1px solid #eae5db; font-size:13.5px; text-align:left; vertical-align:top; }
    th { font-size:10px; letter-spacing:.14em; text-transform:uppercase; color:#6d6d64; }
    .box { width:26px; } .box:after { content:''; display:block; width:15px; height:15px; border:1.5px solid #b3925a; border-radius:3px; }
    .qty { font-family:'Cormorant Garamond',Georgia,serif; font-size:22px; color:#b3925a; width:42px; }
    .who { color:#6d6d64; font-size:11.5px; }
    @media print { body { margin:16mm; } }
  </style></head><body>
  <h1>Shopping List</h1>
  <div class="sub">Detroit Bridal Shower &middot; ${scope === 'all' ? 'all couples' : 'couples still collecting'} &middot; ${when}</div>
  <table><thead><tr><th></th><th>Qty</th><th>Item</th></tr></thead><tbody>${rows}</tbody></table>
  <h2>By couple</h2>
  <table><thead><tr><th>Couple</th><th>Asked for</th></tr></thead><tbody>${byCouple}</tbody></table>
  </body></html>`);
  w.document.close();
  w.focus();
  setTimeout(() => w.print(), 600);
}

async function load() {
  const res = await fetch('/newAdmin/data');
  if (!res.ok) return;
  const data = await res.json();
  couples = data.couples || [];
  render();
}
load();
</script>
</body>
</html>
